

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_local_jwt_secret
# AWS: store in AWS Secrets Manager and inject via ECS task definition
JWT_EXPIRY=1h

# ── Auth Service DB ───────────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgres://auth_user:auth_pass@postgres-auth:5432/auth_db
# AWS: AUTH_DATABASE_URL=postgres://<user>:<pass>@<rds-endpoint>:5432/auth_db

# ── Item Service DB ───────────────────────────────────────────────────────────
ITEM_DATABASE_URL=postgres://item_user:item_pass@postgres-item:5432/item_db
# AWS: ITEM_DATABASE_URL=postgres://<user>:<pass>@<rds-endpoint>:5432/item_db

# ── Matching Service DB ───────────────────────────────────────────────────────
MATCHING_DATABASE_URL=postgres://match_user:match_pass@postgres-matching:5432/matching_db
# AWS: MATCHING_DATABASE_URL=postgres://<user>:<pass>@<rds-endpoint>:5432/matching_db

# ── Admin Service DB ──────────────────────────────────────────────────────────
ADMIN_DATABASE_URL=postgres://admin_user:admin_pass@postgres-admin:5432/admin_db
# AWS: ADMIN_DATABASE_URL=postgres://<user>:<pass>@<rds-endpoint>:5432/admin_db

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# AWS: replace RabbitMQBroker with SQS adapter; set SQS queue URLs instead
# AWS: RABBITMQ_URL= (not used — swap MessageBroker implementation to SQS adapter)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# AWS: REDIS_URL=redis://<elasticache-endpoint>:6379

# ── S3 / LocalStack ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localstack:4566
# AWS: S3_ENDPOINT= (remove this line — AWS SDK defaults to real S3)
S3_BUCKET=lost-and-found-images
# AWS: S3_BUCKET=<your-s3-bucket-name>
AWS_ACCESS_KEY_ID=test
# AWS: AWS_ACCESS_KEY_ID=<real-access-key> (or use IAM role — preferred)
AWS_SECRET_ACCESS_KEY=test
# AWS: AWS_SECRET_ACCESS_KEY=<real-secret-key> (or use IAM role — preferred)
AWS_REGION=us-east-1
# AWS: AWS_REGION=<your-region>

# ── SMTP / MailHog ────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
# AWS: SMTP_HOST=email-smtp.<region>.amazonaws.com
SMTP_PORT=1025
# AWS: SMTP_PORT=587
SMTP_USER=
# AWS: SMTP_USER=<ses-smtp-username>
SMTP_PASS=
# AWS: SMTP_PASS=<ses-smtp-password>
SMTP_FROM=noreply@lostandfound.local
# AWS: SMTP_FROM=noreply@<your-verified-domain>

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
# AWS: OPENSEARCH_URL=https://<opensearch-domain-endpoint>

# ── Matching ──────────────────────────────────────────────────────────────────
MATCH_THRESHOLD=0.5
# AWS: MATCH_THRESHOLD=0.5 (same value, adjust as needed)

# ── Internal service URLs (used by Notification Service) ─────────────────────
AUTH_SERVICE_URL=http://auth:4001
# AWS: AUTH_SERVICE_URL=http://<auth-service-internal-alb-or-ecs-dns>
